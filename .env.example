# Copie para .env e preencha. Nunca commite o .env.
LOG_LEVEL=info
# Postgres do docker-compose.yml. Suba com "npm run db:up".
DATABASE_URL=postgres://alerta:alerta@localhost:5433/alerta

# ─── Shopee Affiliate Open API ──────────────────────────────────────────────
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
# Marcador de origem no link de afiliado. SÓ letras e números: a Shopee recusa
# hífen e underscore com "invalid sub id", e o link sai sem rastreio.
SHOPEE_SUB_ID=wagroup
# Páginas do feed por termo. Páginas x tamanho = produtos vistos por rodada.
SHOPEE_PAGES=5
SHOPEE_PAGE_SIZE=50

# ─── O que buscar ───────────────────────────────────────────────────────────
# Vazio de propósito: o assunto vem da linha de comando, não daqui.
#   npm run ideia -- --tema academia
#   npm run photos -- --keywords "perfume masculino"
# Preencha só se quiser voltar a ter um nicho fixo (ex: camisa masculina,tenis
# masculino). Sem isso e sem --tema, o comando para com erro em vez de
# buscar o feed aleatório da Shopee.
SHOPEE_KEYWORDS=

# ─── Filtros ────────────────────────────────────────────────────────────────
MIN_RATING=4.0
# Mínimo de vendas. Antes isso estava como MIN_REVIEWS, que o código nunca leu.
MIN_SALES=100
MIN_DISCOUNT=0.20
# Acima disso é erro de preço ou isca, não promoção.
MAX_DISCOUNT=0.70
# Corte visual da foto (0-1). Abaixo disso é recorte de catálogo em fundo branco.
MIN_IMAGE_SCORE=0.45
# Quantas ofertas por execução.
TOP_N=15
# Dias sem repetir um produto no conteúdo (photos/ideia).
POST_COOLDOWN_DAYS=14

# ─── Baseline de preço ──────────────────────────────────────────────────────
# Antes estavam como MIN_SNAPSHOTS_FOR_BASELINE / MIN_BASELINE_AGE_DAYS, que o
# código nunca leu — rodavam no padrão. Estes são os nomes certos.
BASELINE_MIN_SNAPSHOTS=8
BASELINE_MIN_DAYS=14

# ─── IA (obrigatória — sem ela não sai post) ────────────────────────────────
REMOTE_AI_BASE_URL=https://api.groq.com/openai/v1
REMOTE_AI_API_KEY=
REMOTE_AI_MODEL=openai/gpt-oss-120b
# Reservas, em ordem, quando o principal bate no limite por minuto.
# Na Groq cada MODELO tem seu balde de 8.000 tokens/min. Nao adianta por
# qualquer um: o qwen/qwen3.6-27b devolve 400 json_validate_failed com o
# prompt do plano ate de balde cheio, e o groq/compound-mini roteia por
# dentro pro gpt-oss-120b — herda a cota da qual se esta fugindo.
REMOTE_AI_FALLBACKS=openai/gpt-oss-20b
# Pra quem o perfil fala. Sem SHOPEE_KEYWORDS, esta linha é a ÚNICA coisa que
# diz isso pra IA — vazia, "academia" pode voltar com legging feminina.
# Deduzi do nicho que estava aqui antes; ajuste se estiver errado.
AI_PUBLICO=homem 20-40 que quer parecer arrumado gastando pouco

# ─── Identidade nos cards ───────────────────────────────────────────────────
CTA_TEXT=LINK NA BIO
# Convite do grupo. Vai só pro 00-LEGENDA.txt, pra você colar no direct.
GRUPO_URL=
# Palavra do CTA: "comenta LINK que eu mando o grupo no direct". Vazio = bio.
GRUPO_PALAVRA=LINK
PROFILE_HANDLE=

# ─── Capa ───────────────────────────────────────────────────────────────────
# Os retratos da capa, uma pasta por casting. "npm run capas" mostra o que tem.
# Pasta vazia não quebra nada: a capa volta a ser a foto do produto desfocada.
CAPAS_DIR=./assets/capas
# Só pro "npm run capas:fetch", que enche as pastas de arquétipo com retrato
# livre. Chave grátis e na hora em pexels.com/api. Nada mais no projeto usa.
PEXELS_API_KEY=

# ─── WhatsApp ───────────────────────────────────────────────────────────────
WA_AUTH_DIR=./data/wa-auth
WA_GROUP_JID=
# Grupo só seu, ponte pro celular (photos:send).
WA_PERSONAL_GROUP_JID=
# Cliente não-oficial: envio em rajada dá banimento. Não baixe estes valores.
WA_MIN_DELAY_MS=8000
WA_MAX_DELAY_MS=20000

# Ver .env.example: grava só o que você escolhe; true mantém o baseline vivo.
RECORD_KNOWN=false
DB_MAX_AGE_DAYS=7
